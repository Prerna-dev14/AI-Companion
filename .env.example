# ==========================================
# AI Companion Environment Configuration
# ==========================================

# Application
APP_NAME="AI Companion API"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated or JSON array)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL default, SQLite fallback supported in dev)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_companion"
# Dev Fallback SQLite example:
# DATABASE_URL="sqlite+aiosqlite:///./ai_companion.db"

# Security & Sessions
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration (Phase 2+)
LLM_PROVIDER="gemini" # gemini, openai, local, etc.
GEMINI_API_KEY=""
LLM_MODEL_NAME="gemini-3.5-flash"

# Speech AI Configuration (Phase 3+)
STT_PROVIDER="whisper"
TTS_PROVIDER="standard"

# Vision Configuration (Phase 4+)
VISION_ENABLED=false
VISION_MAX_FPS=5

# Emotion Engine Configuration (Phase 6+)
EMOTION_FUSION_STRATEGY="weighted_confidence"

# Memory Configuration (Phase 8+)
ENABLE_LONG_TERM_MEMORY=false
